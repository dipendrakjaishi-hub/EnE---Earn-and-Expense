# ==============================================================================
# CREWPULSE - ENVIRONMENT CONFIGURATION (.env.example)
# All Free Tiers (Supabase, Vercel, Resend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage) - Free Tier: https://supabase.com
# ------------------------------------------------------------------------------
# Client-side variables (used by browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-side Next.js equivalents (if deploying to Next.js / Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# ------------------------------------------------------------------------------
# 2. Resend (Email Reports) - Free Tier: 3,000 emails/mo https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=reports@yourverifieddomain.com

# ------------------------------------------------------------------------------
# 3. Application Settings & Secrets
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
CRON_SECRET=generate-a-random-32-char-secret-string-here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
